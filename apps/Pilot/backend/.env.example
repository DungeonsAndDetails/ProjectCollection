PORT=5100
# Atlas connection string for this app's own logical database (cluster is shared across apps).
MONGODB_URI=
# Web application OAuth Client ID from Google Cloud Console — see ../GOOGLE_OAUTH_SETUP.md.
# Must exactly match VITE_GOOGLE_CLIENT_ID in apps/Pilot/frontend/.env.
GOOGLE_CLIENT_ID=
# Any random string 32+ chars, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=
CORS_ORIGIN=http://localhost:5173
