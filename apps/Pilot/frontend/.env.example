# Web application OAuth Client ID from Google Cloud Console — see ../GOOGLE_OAUTH_SETUP.md.
# Must exactly match GOOGLE_CLIENT_ID in apps/Pilot/backend/.env.
# Vite only exposes env vars prefixed VITE_ to client code — see https://vite.dev/guide/env-and-mode.
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=http://localhost:5100
