{
  "name": "projectcollection",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/Portal/frontend",
    "apps/Portal/backend",
    "apps/Project1/frontend",
    "apps/Project1/backend",
    "apps/Project2/frontend",
    "apps/Project2/backend",
    "shared/config",
    "shared/components"
  ],
  "engines": {
    "node": "22.x",
    "npm": ">=11"
  },
  "scripts": {
    "dev:clear-ports": "bash ./scripts/clear-dev-ports.sh",
    "dev:portal:frontend": "npm run dev --workspace apps/Portal/frontend",
    "dev:portal:backend": "npm run dev --workspace apps/Portal/backend",
    "dev:project1:frontend": "npm run dev --workspace apps/Project1/frontend",
    "dev:project1:backend": "npm run dev --workspace apps/Project1/backend",
    "dev:project2:frontend": "npm run dev --workspace apps/Project2/frontend",
    "dev:project2:backend": "npm run dev --workspace apps/Project2/backend",
    "dev:components": "npm run storybook --workspace shared/components",
    "dev:all": "npm run dev:clear-ports && concurrently -n portal-web,portal-api,p1-web,p1-api,p2-web,p2-api,components -c yellow,white,blue,green,magenta,cyan,red \"npm run dev:portal:frontend\" \"npm run dev:portal:backend\" \"npm run dev:project1:frontend\" \"npm run dev:project1:backend\" \"npm run dev:project2:frontend\" \"npm run dev:project2:backend\" \"npm run dev:components\"",
    "test:components": "npm run test --workspace shared/components",
    "test:components:watch": "npm run test:watch --workspace shared/components",
    "build:components": "npm run build-storybook --workspace shared/components",
    "lint": "eslint \"apps/*/frontend/src/**/*.{js,jsx}\" \"apps/*/frontend/*.mjs\" \"apps/*/backend/**/*.js\" \"shared/components/**/*.{js,jsx}\" \"shared/config/**/*.{cjs,mjs}\" eslint.config.mjs prettier.config.cjs",
    "lint:fix": "eslint \"apps/*/frontend/src/**/*.{js,jsx}\" \"apps/*/frontend/*.mjs\" \"apps/*/backend/**/*.js\" \"shared/components/**/*.{js,jsx}\" \"shared/config/**/*.{cjs,mjs}\" eslint.config.mjs prettier.config.cjs --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "tooling:check": "npm outdated eslint @eslint/js eslint-plugin-react eslint-plugin-react-hooks eslint-plugin-react-refresh prettier prettier-plugin-tailwindcss tailwindcss @tailwindcss/vite vite @vitejs/plugin-react || exit 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "9.1.2",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "^1.87.0",
    "tailwindcss": "^4.1.4"
  }
}
